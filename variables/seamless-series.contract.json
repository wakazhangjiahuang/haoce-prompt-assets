{
  "version": 1,
  "syntax": "mustache-simple",
  "variables": {
    "用途": {
      "type": "string"
    },
    "主题方向": {
      "type": "string"
    },
    "元素配置": {
      "type": "string"
    },
    "角色身份关系": {
      "type": "string"
    },
    "排布要求": {
      "type": "string"
    },
    "密度与留白": {
      "type": "string"
    },
    "配色要求": {
      "type": "string"
    },
    "数量": {
      "type": "integer",
      "min": 1
    },
    "比例": {
      "type": "string"
    },
    "分辨率与格式": {
      "type": "string"
    },
